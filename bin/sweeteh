#!/usr/bin/env bash
# sweeteh command, runs the shell and keeps it up to date
set -euo pipefail

name="sweeteh"
unbind="${XDG_RUNTIME_DIR:-/tmp}/sweeteh/unbind.lua"
# left by stop so the crash watchdog in run knows the exit was wanted
stopflag="${XDG_RUNTIME_DIR:-/tmp}/sweeteh/stopping"
repo="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"

say() { printf '%s\n' "$*"; }

# take the shell keybinds out of hyprland once the shell is gone
cleanup() {
  if [[ -s "$unbind" ]]; then
    hyprctl eval "$(cat "$unbind")" >/dev/null 2>&1 || true
    rm -f "$unbind"
  fi
}

running() {
  pgrep -f "^qs -c $name( |$)" >/dev/null 2>&1
}

# a crash brings the shell straight back, a stop or a clean exit does not
# five crashes inside a minute means something is really broken, so give up then
run() {
  if running; then
    say "Sweeteh is already running"
    exit 0
  fi
  local child status crashes=()
  rm -f "$stopflag"
  # without the session bus the shell comes up with no battery, media, tray or notifications
  local tries=0
  while [[ ! -S "${XDG_RUNTIME_DIR:-/run/user/$UID}/bus" ]] && (( tries++ < 50 )); do
    sleep 0.2
  done
  trap 'stopping=1; kill "$child" 2>/dev/null' INT TERM
  stopping=0
  while true; do
    qs -c "$name" --log-rules "qt.qpa.wayland.textinput=false" "$@" &
    child=$!
    status=0
    wait "$child" || status=$?
    wait "$child" 2>/dev/null || true
    [[ $stopping == 1 || -e "$stopflag" ]] && break
    # 128 + signal, segv abrt bus fpe ill trap and the oom killer are crashes, term and int are a stop
    case "$status" in
      132|133|134|135|136|137|139) ;;
      *) break ;;
    esac
    local now
    now="$(date +%s)"
    crashes=("${crashes[@]}" "$now")
    crashes=($(for t in "${crashes[@]}"; do if (( now - t < 60 )); then echo "$t"; fi; done))
    if (( ${#crashes[@]} >= 5 )); then
      say "Sweeteh crashed ${#crashes[@]} times in a minute, not restarting"
      break
    fi
    say "Sweeteh crashed with status $status, starting it again"
    sleep 1
  done
  rm -f "$stopflag"
  cleanup
}

stop() {
  mkdir -p "$(dirname "$stopflag")"
  touch "$stopflag"
  pkill -f "^qs -c $name( |$)" || true
  sleep 0.5
  cleanup
}

restart() {
  stop
  setsid -f "$0" run >/dev/null 2>&1
  say "Sweeteh restarted"
}

# the newest release tag, empty when the repository has none yet
latest_tag() {
  git -C "$repo" tag -l 'v*' --sort=-v:refname | head -n 1
}

current_version() {
  echo "v$(tr -d '[:space:]' < "$repo/VERSION")"
}

check() {
  GIT_TERMINAL_PROMPT=0 git -C "$repo" fetch --tags --force --quiet origin 2>/dev/null || return 0
  local latest
  latest="$(latest_tag)"
  if [[ -n "$latest" && "$latest" != "$(current_version)" ]] && [[ "$(printf '%s\n%s\n' "$latest" "$(current_version)" | sort -V | tail -n 1)" == "$latest" ]]; then
    say "$latest"
  fi
}

update() {
  if [[ ! -d "$repo/.git" ]]; then
    say "This copy of Sweeteh is not a git checkout, run the installer again to update"
    exit 1
  fi
  if [[ -n "$(git -C "$repo" status --porcelain --untracked-files=no)" ]]; then
    say "This checkout has local changes, commit or stash them first"
    exit 1
  fi
  local next
  next="$(check)"
  if [[ -z "$next" ]]; then
    say "Sweeteh $(current_version) is the newest release"
    return
  fi
  say "Updating to $next"
  git -C "$repo" checkout --quiet "$next"
  bash "$repo/install.sh" --no-deps --keep-configs >/dev/null
  restart
  say "Sweeteh is now $next"
}

usage() {
  cat <<USAGE
Usage: sweeteh [command]

  run         Start the shell, this is the default
  stop        Stop the shell, its keybinds go away with it
  restart     Stop and start again
  check       Print the newest release if it is newer than this one
  update      Move to the newest release and restart
  ipc ARGS    Call the shell, for example sweeteh ipc launcher toggle
  fingerprint enable|disable|status   Use your finger for sudo and polkit prompts
USAGE
}

# one block ending in exit, so bash has read all of it before running and an
# update that rewrites this file under a running shell cannot shift what runs next
{
  cmd="${1:-run}"
  shift || true

  case "$cmd" in
    run) run "$@" ;;
    stop) stop ;;
    restart) restart ;;
    update) update ;;
    check) check ;;
    ipc) exec qs -c "$name" ipc call "$@" ;;
    fingerprint) [[ "${1:-status}" == status ]] && exec "$repo/bin/sweeteh-pam" status || exec sudo "$repo/bin/sweeteh-pam" "$@" ;;
    -h|--help|help) usage ;;
    *) usage; exit 1 ;;
  esac
  exit
}
